# The RMM (NinjaOne) API, client-credentials grant. Read-only scopes are enough: this tool never writes.
RMM_BASE_URL=
RMM_TOKEN_URL=
RMM_CLIENT_ID=
RMM_CLIENT_SECRET=
RMM_SCOPE=monitoring management

# The two custom-field NAMES your onboarding writes the organisation-owned GUIDs into, on the RMM
# organisation and on the RMM location. These are the ONLY custom fields this tool reads.
RMM_ORG_GUID_FIELD=
RMM_SITE_GUID_FIELD=

# The matching custom-field names on the PSA client and PSA site.
PSA_CLIENT_GUID_FIELD=
PSA_SITE_GUID_FIELD=

# A PSA directory export (see src/psa/directory.ts for the shape) until a live adapter exists.
PSA_DIRECTORY_FILE=./psa-directory.json

# Where the collector keeps its state: identity rows, the login ledger, grants, GUIDs, bookkeeping.
STATE_FILE=./state/stale-access-audit.json

# Activity page size, hard per-request wall-clock abort, and bearer max age.
PAGE_SIZE=500
RMM_FETCH_TIMEOUT_MS=120000
RMM_TOKEN_MAX_AGE_MS=1800000
